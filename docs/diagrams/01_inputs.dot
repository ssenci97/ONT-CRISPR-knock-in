digraph inputs {
  graph [rankdir=TB, bgcolor="white", fontname="Helvetica", fontsize=24, labelloc=t, nodesep=0.35, ranksep=0.4, compound=true,
         label="The per-sample inputs, handed to each tool under its own argument\n "];
  node [fontname="Helvetica", fontsize=19, shape=box, style="rounded,filled", color="#8e8e93", penwidth=1.4, fontcolor="#1d1d1f", margin="0.2,0.12"];
  edge [color="#48484a", arrowsize=1.0, penwidth=1.4];

  subgraph cluster_user {
    label="submitted by you"; fontname="Helvetica"; fontsize=19; color="#8e8e93"; style=dashed;
    sheet [label=<configs/samples<B>.tsv</B><BR/>sample_id, fastq_path or srr,<BR/>condition, control>, fillcolor="#fff1d6"];
    yaml  [label=<configs/param_configs<B>.yaml</B><BR/>shared + per-step parameters>, fillcolor="#fff1d6"];
  }
  subgraph cluster_made {
    label="built by 01_fetch and 02_refs"; fontname="Helvetica"; fontsize=19; color="#8e8e93"; style=dashed;
    fastq  [label=<data/&lt;sample_id&gt;<B>.fastq.gz</B><BR/>length-filtered reads>, fillcolor="#dff2ea"];
    refs   [label=<refs/TRAC_WT<B>.fa</B><BR/>refs/TRAC_KI<B>.fa</B><BR/>refs/CAR_insert<B>.fa</B>>, fillcolor="#dff2ea"];
    design [label=<refs/design<B>.json</B><BR/>guide, cut site, primers,<BR/>homology arms, insert length>, fillcolor="#dff2ea"];
    alpcfg [label=<refs/alpine/ref<B>.fa</B><BR/>refs/alpine/config<B>.tsv</B>>, fillcolor="#dff2ea"];
  }

  table [shape=plaintext, style="", label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8" COLOR="#8e8e93">
      <TR><TD BGCOLOR="#1f5f4f"><FONT COLOR="white" POINT-SIZE="19"><B>input</B></FONT></TD>
          <TD BGCOLOR="#1f5f4f"><FONT COLOR="white" POINT-SIZE="19"><B>ALPINE</B></FONT></TD>
          <TD BGCOLOR="#1f5f4f"><FONT COLOR="white" POINT-SIZE="19"><B>CRISPRLungo</B></FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="18"><B>reads</B></FONT></TD><TD><FONT POINT-SIZE="18">fastqfile</FONT></TD><TD><FONT POINT-SIZE="18">positional</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="18"><B>WT amplicon</B></FONT></TD><TD><FONT POINT-SIZE="18">reffile (WT_TRAC)</FONT></TD><TD><FONT POINT-SIZE="18">positional</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="18"><B>KI amplicon</B></FONT></TD><TD><FONT POINT-SIZE="18">reffile (Ref_HDR_CD19)</FONT></TD><TD><FONT POINT-SIZE="18">--induced_sequence_path</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="18"><B>inserted gene</B></FONT></TD><TD><FONT POINT-SIZE="18">config.tsv gene_start/end</FONT></TD><TD><FONT POINT-SIZE="18">--integration_file</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="18"><B>guide</B></FONT></TD><TD><FONT POINT-SIZE="18">cut site in config.tsv</FONT></TD><TD><FONT POINT-SIZE="18">positional + --cleavage_pos</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="18"><B>primers</B></FONT></TD><TD><FONT POINT-SIZE="18">primer_1 / primer_2</FONT></TD><TD><FONT POINT-SIZE="18">not used</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="18"><B>homology arms</B></FONT></TD><TD><FONT POINT-SIZE="18">five/three_prime_HA_seq</FONT></TD><TD><FONT POINT-SIZE="18">not used</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="18"><B>KI threshold</B></FONT></TD><TD><FONT POINT-SIZE="18">truncated_cutoff</FONT></TD><TD><FONT POINT-SIZE="18">applied in 05_summary</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="18"><B>control sample</B></FONT></TD><TD><FONT POINT-SIZE="18">not used</FONT></TD><TD><FONT POINT-SIZE="18">--control</FONT></TD></TR>
    </TABLE>>];

  sheet -> yaml [style=invis]; fastq -> refs [style=invis]; design -> alpcfg [style=invis];
  yaml -> table [ltail=cluster_user]; refs -> table [ltail=cluster_made]; alpcfg -> table [style=invis];
}
