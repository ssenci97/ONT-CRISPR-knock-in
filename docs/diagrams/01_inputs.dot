digraph inputs {
  graph [rankdir=LR, bgcolor="white", fontname="Helvetica", fontsize=11, labelloc=t,
         label="The per-sample input contract: the same six files, handed to each tool under its own flag"];
  node [fontname="Helvetica", fontsize=10, shape=box, style="rounded,filled", color="#c9c4bb", penwidth=1.1];
  edge [color="#6b6862", arrowsize=0.7];

  subgraph cluster_made {
    label="built once by steps 01-04"; fontname="Helvetica"; fontsize=10; color="#c9c4bb"; style=dashed;
    fastq  [label="data/<sample_id>.fastq.gz\n(length-filtered reads)", fillcolor="#e8f1ee"];
    refs   [label="refs/TRAC_WT.fa\nrefs/TRAC_KI.fa\nrefs/CAR_insert.fa", fillcolor="#e8f1ee"];
    design [label="refs/design.json\n(guide, cut site, primers,\nhomology arms, insert length)", fillcolor="#e8f1ee"];
    alpcfg [label="refs/alpine/ref.fa\nrefs/alpine/config.tsv", fillcolor="#e8f1ee"];
  }
  subgraph cluster_user {
    label="submitted by you"; fontname="Helvetica"; fontsize=10; color="#c9c4bb"; style=dashed;
    sheet [label="configs/samples.tsv\n(sample_id, srr, condition, control)", fillcolor="#fdf2e3"];
    yaml  [label="configs/param_configs.yaml\n(shared + per-step parameters)", fillcolor="#fdf2e3"];
  }

  table [shape=plaintext, label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5">
      <TR><TD BGCOLOR="#1f6f5c"><FONT COLOR="white" POINT-SIZE="10"><B>input</B></FONT></TD>
          <TD BGCOLOR="#1f6f5c"><FONT COLOR="white" POINT-SIZE="10"><B>ALPINE</B></FONT></TD>
          <TD BGCOLOR="#1f6f5c"><FONT COLOR="white" POINT-SIZE="10"><B>CRISPRLungo</B></FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">reads</FONT></TD><TD><FONT POINT-SIZE="9">fastqfile</FONT></TD><TD><FONT POINT-SIZE="9">positional</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">WT amplicon</FONT></TD><TD><FONT POINT-SIZE="9">reffile (WT_TRAC)</FONT></TD><TD><FONT POINT-SIZE="9">positional</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">KI amplicon</FONT></TD><TD><FONT POINT-SIZE="9">reffile (Ref_HDR_CD19)</FONT></TD><TD><FONT POINT-SIZE="9">--induced_sequence_path</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">CAR insert</FONT></TD><TD><FONT POINT-SIZE="9">config.tsv gene_start/end</FONT></TD><TD><FONT POINT-SIZE="9">--integration_file</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">guide</FONT></TD><TD><FONT POINT-SIZE="9">cut site in config.tsv</FONT></TD><TD><FONT POINT-SIZE="9">positional + --cleavage_pos</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">primers</FONT></TD><TD><FONT POINT-SIZE="9">primer_1 / primer_2</FONT></TD><TD><FONT POINT-SIZE="9">not used</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">homology arms</FONT></TD><TD><FONT POINT-SIZE="9">five/three_prime_HA_seq</FONT></TD><TD><FONT POINT-SIZE="9">not used</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">KI threshold</FONT></TD><TD><FONT POINT-SIZE="9">truncated_cutoff</FONT></TD><TD><FONT POINT-SIZE="9">applied in 07_summary</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">control sample</FONT></TD><TD><FONT POINT-SIZE="9">not used</FONT></TD><TD><FONT POINT-SIZE="9">--control</FONT></TD></TR>
    </TABLE>>];

  fastq -> table; refs -> table; design -> table; alpcfg -> table; sheet -> table; yaml -> table;
}
