digraph single_tool {
  graph [rankdir=LR, bgcolor="white", fontname="Helvetica", fontsize=11, labelloc=t,
         label="One rule, one sample:  snakemake --profile profiles/slurm --config analysis=<name> results/<name>/CRISPRLungo/<sample_id>/results/read_classification.txt"];
  node [fontname="Helvetica", fontsize=10, shape=box, style="rounded,filled", color="#c9c4bb", penwidth=1.1];
  edge [color="#6b6862", arrowsize=0.7];

  subgraph cluster_in {
    label="read from disk, unchanged"; fontname="Helvetica"; fontsize=10; color="#1f6f5c"; style=dashed;
    fastq  [label="results/<name>/data/<sample_id>.fastq.gz", fillcolor="#e8f1ee"];
    refs   [label="results/<name>/refs/TRAC_WT.fa\nTRAC_KI.fa\nCAR_insert.fa", fillcolor="#e8f1ee"];
    design [label="results/<name>/refs/design.json", fillcolor="#e8f1ee"];
    sheet  [label="results/<name>/inputs/samples.tsv", fillcolor="#fdf2e3"];
    yaml   [label="results/<name>/inputs/params.yaml", fillcolor="#fdf2e3"];
  }
  step [label="rule lungo\none SLURM job for this sample", fillcolor="#f2eff9"];
  out  [label="results/<name>/CRISPRLungo/<sample_id>/", fillcolor="#f6f5f2"];
  meta [label="results/<name>/meta/<sample_id>.json\n(step record appended)", fillcolor="#f6f5f2"];

  fastq -> step; refs -> step; design -> step; sheet -> step; yaml -> step;
  step -> out; step -> meta;
  note [shape=note, fillcolor="#fdf2e3", label="Snakemake builds the inputs first\nif they are missing, and nothing else."];
  { rank=same; step; note; }
}
