digraph console {
  graph [rankdir=LR, bgcolor="white", fontname="Helvetica", fontsize=11, labelloc=t,
         label="What a wet-lab user does on Orfeo: three clicks, no shell"];
  node [fontname="Helvetica", fontsize=10, shape=box, style="rounded,filled", color="#c9c4bb", penwidth=1.1];
  edge [color="#6b6862", arrowsize=0.7];

  build [label="containers/build.sh orfeo\n(once: singularity pull, no root)", fillcolor="#fdf2e3"];
  sif [label="containers/ont-knockin-val.sif", fillcolor="#e8f1ee"];
  build -> sif;

  serve [label="python3 src/gui_serve.py\non the login node", fillcolor="#fdf2e3"];
  subgraph cluster_gui {
    label="http://127.0.0.1:8000 (ssh -L tunnel)"; fontname="Helvetica"; fontsize=10; color="#1f6f5c"; style=dashed;
    t1 [label="1. Samples\nform -> samples.tsv\n+ samples/<id>.json", fillcolor="#f2eff9"];
    t2 [label="2. Run\n[Run default pipeline]", fillcolor="#f2eff9"];
    t3 [label="3. Results\nKI% matrix + per-sample\nmetadata", fillcolor="#f2eff9"];
  }
  serve -> t1 [style=dotted]; t1 -> t2 -> t3;

  sb [label="snakemake --profile profiles/slurm\n--config analysis=<name>", fillcolor="#f6f5f2"];
  steps [label="every rule runs\ninside the .sif", fillcolor="#f6f5f2"];
  out [label="results/<name>/summary_matrix.tsv\nresults/<name>/meta/<id>.json", fillcolor="#1f6f5c", fontcolor="white", penwidth=0];
  t2 -> sb -> steps -> out; sif -> steps [style=dotted]; out -> t3 [constraint=false];
}
