digraph all_tools {
  graph [rankdir=LR, bgcolor="white", fontname="Helvetica", fontsize=11, labelloc=t,
         label="All-tools run:  bash slurms/run_all.sh --sbatch   (same inputs, same files, three readers)"];
  node [fontname="Helvetica", fontsize=10, shape=box, style="rounded,filled", color="#c9c4bb", penwidth=1.1];
  edge [color="#6b6862", arrowsize=0.7];

  c1 [label="01_clone", fillcolor="#f6f5f2"];
  c2 [label="02_envs", fillcolor="#f6f5f2"];
  c3 [label="03_fetch", fillcolor="#f6f5f2"];
  c4 [label="04_build_refs", fillcolor="#f6f5f2"];
  c1 -> c2 -> c3 -> c4 [label="afterok", fontsize=9, fontname="Helvetica"];

  subgraph cluster_in {
    label="read from disk, unchanged"; fontname="Helvetica"; fontsize=10; color="#1f6f5c"; style=dashed;
    fastq  [label="data/<sample_id>.fastq.gz", fillcolor="#e8f1ee"];
    refs   [label="refs/TRAC_WT.fa\nrefs/TRAC_KI.fa\nrefs/CAR_insert.fa", fillcolor="#e8f1ee"];
    design [label="refs/design.json", fillcolor="#e8f1ee"];
    sheet  [label="configs/samples.tsv", fillcolor="#fdf2e3"];
    yaml   [label="configs/param_configs.yaml", fillcolor="#fdf2e3"];
  }
  c3 -> fastq; c4 -> refs; c4 -> design;

  contract [label="one input set", shape=box, style=filled, fillcolor="#1f6f5c", fontcolor="white", penwidth=0];
  fastq -> contract; refs -> contract; design -> contract; sheet -> contract; yaml -> contract;

  a [label="05_alpine", fillcolor="#f2eff9"];
  l [label="06_lungo", fillcolor="#f2eff9"];
  cr [label="07_crispresso", fillcolor="#f2eff9"];
  contract -> a; contract -> l; contract -> cr;

  s [label="08_summary\nresults/summary_matrix.tsv", fillcolor="#f6f5f2"];
  a -> s; l -> s; cr -> s [label="afterany", fontsize=9, fontname="Helvetica"];
}
