digraph all_tools {
  graph [rankdir=TB, bgcolor="white", fontname="Helvetica", fontsize=24, labelloc=t, nodesep=0.35, ranksep=0.55,
         label="Whole analysis\nsnakemake --profile profiles/slurm --config analysis=<name>\nsame inputs, same files, two readers\n "];
  node [fontname="Helvetica", fontsize=19, shape=box, style="rounded,filled", color="#8e8e93", penwidth=1.4, fontcolor="#1d1d1f", margin="0.2,0.12"];
  edge [color="#48484a", arrowsize=1.0, penwidth=1.4, fontname="Helvetica", fontsize=16];

  c1 [label="src/analysis.py <name>\nfreezes results/<name>/inputs/", fillcolor="#fff1d6"];
  c3 [label="01_fetch\nena, download, filter", fillcolor="#f2f2f7"];
  c4 [label="02_refs\nrefs", fillcolor="#f2f2f7"];
  c1 -> c3; c1 -> c4;

  subgraph cluster_in {
    label="read from disk, unchanged"; fontname="Helvetica"; fontsize=19; color="#1f5f4f"; style=dashed;
    fastq  [label="data/<sample_id>.fastq.gz", fillcolor="#dff2ea"];
    refs   [label="refs/*.fa\nrefs/design.json", fillcolor="#dff2ea"];
    frozen [label="inputs/samples.tsv\ninputs/params.yaml", fillcolor="#fff1d6"];
  }
  c3 -> fastq; c4 -> refs; c1 -> frozen;

  a [label="03_alpine\none job per sample", fillcolor="#ece8f7"];
  l [label="04_lungo\none job per sample", fillcolor="#ece8f7"];
  fastq -> a; refs -> a; frozen -> a; fastq -> l; refs -> l; frozen -> l;

  s [label="05_summary\nresults/<name>/summary_matrix.tsv", fillcolor="#1f5f4f", fontcolor="white", penwidth=0];
  a -> s; l -> s;
}
